{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fotollection",
  "identifier": "com.hoangphi01.fotollection",
  "build": {
    "beforeDevCommand": "npm run dev --workspace ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --workspace ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fotollection",
        "width": 1280,
        "height": 820,
        "minWidth": 1180,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' fotothumb: http://fotothumb.localhost data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "copyright": "© hoangphi01 — GPL-3.0-only",
    "shortDescription": "Fast, private, offline photo-print preparation",
    "fileAssociations": [
      {
        "ext": ["fotollection"],
        "name": "Fotollection project",
        "description": "Fotollection project",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.fotollection.project+zip",
        "exportedType": {
          "identifier": "com.hoangphi01.fotollection.project",
          "conformsTo": ["public.zip-archive", "public.data"]
        }
      }
    ]
  }
}
