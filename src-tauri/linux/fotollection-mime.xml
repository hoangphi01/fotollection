<!-- The project file type, so "Open with" and file managers know .fotollection (ADR-0034). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.fotollection.project+zip">
    <comment>Fotollection project</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.fotollection"/>
  </mime-type>
</mime-info>
