"c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#7a6a55;strokeWidth=1.5;fontColor=#7a6a55;fontSize=11;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="Vložený náhled&#10;fotoaparátu&#10;→ miniatury&#10;mřížky, 9–32 ms" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#efe5cc;strokeColor=#e2d4b3;fontColor=#514435;fontSize=12;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="170" height="86" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#7a6a55;strokeWidth=1.5;fontColor=#7a6a55;fontSize=11;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="c3" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="rounded=0;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="210" y="268" width="18" height="18" as="geometry"/></mxCell><mxCell id="c23" value="Vlastní kód Fotollection na všech jádrech procesoru" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#514435;fontSize=12;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="234" y="262" width="330" height="30" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=0;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#f4dfcc;strokeColor=#b5652a;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="610" y="268" width="18" height="18" as="geometry"/></mxCell><mxCell id="c25" value="rawler (LGPL), jen rozbalení" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#514435;fontSize=12;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="634" y="262" width="330" height="30" as="geometry"/></mxCell><mxCell id="c26" value="Od v0.11.0: jedno vyvolání najednou, nikdy ve vlákně okna. Rawler nebo macOS vyvolávají jen&#10;formáty, které naše čtečka zatím nebere (X-Trans do v0.15.0); na Macu zůstávají Panasonic a Olympus u macOS kvůli korekci objektivu." style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#7a6a55;fontSize=12;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="1010" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="raw-develop-de" name="DE"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="RAW-Datei&#10;CR3 · NEF · ARW&#10;RW2 · ORF · DNG…" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#fffaee;strokeColor=#514435;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c4" value="1 · Erkennen&#10;an den ersten Bytes,&#10;nicht am Namen" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="210" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c5" value="2 · Sensor lesen&#10;DNG: eigener Reader&#10;andere: rawler entpackt" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#f4dfcc;strokeColor=#b5652a;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="410" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c6" value="3 · Pegel&#10;Schwarz auf 0, Weiß auf 1&#10;je Filterposition" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="610" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c7" value="4 · Weißabgleich&#10;die Faktoren der Kamera,&#10;vor dem Demosaicing" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="810" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c8" value="5 · Demosaicing&#10;Hotpixel, Grüntöne,&#10;Richtung, Falschfarben" style="rounded=1;arcSize=12;whiteSpace=