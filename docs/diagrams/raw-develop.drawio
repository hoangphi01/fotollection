e="rawler (LGPL), chỉ giải nén" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#514435;fontSize=12;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="634" y="262" width="330" height="30" as="geometry"/></mxCell><mxCell id="c26" value="Từ v0.11.0: mỗi lần xử lý một ảnh, không bao giờ trên luồng của cửa sổ. Rawler hoặc macOS chỉ còn xử lý&#10;các định dạng bộ đọc của chúng tôi chưa nhận (X-Trans, tới v0.15.0); trên Mac, Panasonic và Olympus vẫn do macOS xử lý để được sửa méo ống kính." style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#7a6a55;fontSize=12;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="1010" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="raw-develop-cs" name="CS"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Soubor RAW&#10;CR3 · NEF · ARW&#10;RW2 · ORF · DNG…" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#fffaee;strokeColor=#514435;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c4" value="1 · Rozpoznání&#10;podle prvních bajtů,&#10;ne podle názvu" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="210" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c5" value="2 · Čtení snímače&#10;DNG: naše čtečka&#10;ostatní: rozbalí rawler" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#f4dfcc;strokeColor=#b5652a;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="410" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c6" value="3 · Úrovně&#10;černá na 0, bílá na 1&#10;pro každou pozici filtru" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="610" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c7" value="4 · Vyvážení bílé&#10;zisky fotoaparátu,&#10;před demosaicingem" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="810" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c8" value="5 · Demosaicing&#10;vadné pixely, zelené,&#10;směrový, falešné barvy" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="210" y="150" width="170" height="86" as="geometry"/></mxCell><mxCell id="c9" value="6 · Barvy&#10;fotoaparát → XYZ → sRGB&#10;v lineárním světle" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeCol