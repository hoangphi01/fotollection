<mxfile host="Fotollection"><diagram id="raw-develop-0" name="EN"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="RAW file&#10;CR3 · NEF · ARW&#10;RW2 · ORF · DNG…" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#fffaee;strokeColor=#514435;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c4" value="1 · Recognise&#10;from the first bytes,&#10;not the name" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="210" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c5" value="2 · Read the sensor&#10;DNG: our own reader&#10;others: rawler unpacks" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#f4dfcc;strokeColor=#b5652a;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="410" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c6" value="3 · Levels&#10;black to 0, white to 1&#10;per filter position" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="610" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id