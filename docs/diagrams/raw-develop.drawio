 only the&#10;formats our reader does not take yet (X-Trans until v0.15.0); on a Mac, Panasonic and Olympus stay with macOS for its lens correction." style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#7a6a55;fontSize=12;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="1010" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="raw-develop-1" name="VI"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Tệp RAW&#10;CR3 · NEF · ARW&#10;RW2 · ORF · DNG…" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#fffaee;strokeColor=#514435;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c4" value="1 · Nhận biết&#10;từ những byte đầu,&#10;không theo tên tệp" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="210" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c5" value="2 · Đọc cảm biến&#10;DNG: bộ đọc riêng&#10;khác: rawler giải nén" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#f4dfcc;strokeColor=#b5652a;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="410" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c6" value="3 · Mức&#10;đen về 0, trắng về 1&#10;theo vị trí tấm lọc" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="610" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c7" value="4 · Cân bằng trắng&#10;hệ số của máy ảnh,&#10;trước demosaic" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="810" y="0" width="170" height="76" as="geometry"/></mxCell><mxCell id="c8" value="5 · Demosaic&#10;điểm chết, xanh lá,&#10;theo hướng, màu giả" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="210" y="150" width="170" height="86" as="geometry"/></mxCell><mxCell id="c9" value="6 · Màu&#10;máy ảnh → XYZ → sRGB&#10;trong ánh sáng tuyến tính" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="410" y="150" width="170" height="86" as="geometry"/></mxCell><mxCell id="c10" value="7 · Tông và màu riêng&#10;khớp theo bản xem trước&#10;của máy, độ tối góc" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,