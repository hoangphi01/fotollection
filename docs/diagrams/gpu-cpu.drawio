nalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#2c836d;strokeWidth=1.5;fontColor=#7a6a55;fontSize=11;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;" edge="1" parent="1" source="c45" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="kódování" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#fffaee;strokeColor=#2c836d;fontColor=#2b2219;fontSize=12;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="864" y="286" width="112" height="36" as="geometry"/></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#2c836d;strokeWidth=1.5;fontColor=#7a6a55;fontSize=11;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;" edge="1" parent="1" source="c46" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="Každá fotka se dekóduje, vykreslí a zakóduje na jednom jádře, takže až šest&#10;se zpracovává najednou, kolik se vejde do paměťového limitu 1,6 GB.&#10;JPEGy s 26 MP: 10,8 fotky za sekundu. Na každém počítači stejné bajty." style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#514435;fontSize=12;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="540" y="334" width="440" height="86" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="gpu-cpu-de" name="DE"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#efe5cc;strokeColor=#e2d4b3;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="480" height="430" as="geometry"/></mxCell><mxCell id="c4" value="Während du einen Farbregler ziehst" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#2b2219;fontSize=16;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="440" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Der Rust-Kern baut den Look als eine 33³-Tabelle&#10;0,9–1,3 ms" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#2c836d;strokeColor=#2c836d;fontColor=#fffaee;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="440" height="60" as="geometry"/></mxCell><mxCell id="c6" value="Die Grafikkarte (WebGL2) zeichnet ihn auf die Vorschau&#10;1–2 ms pro Schritt; ohne Stempel und Rahmen" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#fffaee;strokeColor=#b5652a;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="440" height="60" as="geometry"/></mxCell><mxCell id="c7" value="Ohne fähige Grafikkarte: Rust berechnet den Look,&#10;kodiert ein Vorschau-JPEG, die Web-Ansicht dekodiert es&#10;etwa 26 ms pro Schritt; Fotollection entscheidet selbst" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#fffaee;strokeColor=#e2d4b3;fontColor=#514435;fontSize=12;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="244" width="440" height="74" as="geometry"/></mxCell><mxCell id="c8" value="Du lässt los: Die exakte Berechnung von Rust übernimmt&#10;im Mittel 0,13 ΔE2000 Abstand, unter dem, was ein Auge sieht" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="20" y="352" width="440" height="60" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#b5652a;strokeWidth=1.5;fontColor=#7a6a55;fontSize=11;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#7a6a55;strokeWidth=1.5;fontColor=#7a6a55;fontSize=11;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="180"/><mxPoint x="470" y="382"/></Array></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#7a6a55;strokeWidth=1.5;fontColor=#7a6a55;fontSize=11;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="10" y="86"/><mxPoint x="10" y="281"/></Array></mxGeometry></mxCell><mxCell id="c12" value="" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#fffaee;strokeColor=#e2d4b3;fontCo