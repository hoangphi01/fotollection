Size=11;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;" edge="1" parent="1" source="c46" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="Minden fotót egyetlen mag dekódol, renderel és kódol, így akár hat&#10;készül egyszerre, ahány belefér az 1,6 GB-os memóriakeretbe.&#10;26 MP-es JPEG: 10,8 fotó/s. Minden gépen ugyanazok a bájtok." style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#514435;fontSize=12;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="540" y="334" width="440" height="86" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="gpu-cpu-ja" name="JA"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#efe5cc;strokeColor=#e2d4b3;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="480" height="430" as="geometry"/></mxCell><mxCell id="c4" value="カラースライダーをドラッグしている間" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#2b2219;fontSize=16;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="440" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Rust コアがルックを 1 つの 33³ テーブルに構築&#10;0.9〜1.3 ms" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#2c836d;strokeColor=#2c836d;fontColor=#fffaee;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="440" height="60" as="geometry"/></mxCell><mxCell id="c6" value="グラフィックカード (WebGL2) がプレビューに描画&#10;1 ステップ 1〜2 ms、日付とフレームは除く" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#fffaee;strokeColor=#b5652a;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="440" height="60" as="geometry"/></mxCell><mxCell id="c7" value="対応するグラフィックカードがない場合：Rust がルックをレンダリングし、&#10;プレビュー JPEG にエンコード、WebView がデコード&#10;1 ステップ約 26 ms、アプリが自動で判断" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#fffaee;strokeColor=#e2d4b3;fontColor=#514435;fontSize=12;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="244" width="440" height="74" as="geometry"/></mxCell><mxCell id="c8" value="手を離すと Rust の正確なレンダリングに切り替え&#10;差は平均 0.13 ΔE2000、目に見えない範囲" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="20" y="352" width="440" height="60" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#b5652a;strokeWidth=1.5;fontColor=#7a6a55;fontSize=11;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#7a6a55;strokeWidth=1.5;fontColor=#7a6a55;fontSi