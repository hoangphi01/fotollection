<mxfile host="Fotollection"><diagram id="develop-gate-0" name="EN"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#efe5cc;strokeColor=#e2d4b3;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1040" height="380" as="geometry"/></mxCell><mxCell id="c3" value="The develop gate: the photo on screen goes first" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#2b2219;fontSize=16;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c4" value="The photo on screen&#10;preview · zoom · crop · the sheet shown" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#2c836d;strokeColor=#2c836d;fontColor=#fffaee;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="380" height="80" as="geometry"/></mxCell><mxCell id="c5" value="Work you are not waiting for&#10;standard previews · prefetch · the size estimate&#10;exports · best-shot analyses" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#fffaee;strokeColor=#e2d4b3;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="380" height="100" as="geometry"/></mxCell><mxCell id="c6" value="The develop gate&#10;one RAW develop at a time&#10;by priority" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="470" y="95" width="260" height="140" as="geometry"/></mxCell><mxCell id="c7" value="RAW develop&#10;0.3–0.7 s a photo" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#fffaee;strokeColor=#e2d4b3;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="800" y="125" width="220" height="80" as="geometry"/></mxCell><mxCell id="c8" value="goes first" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#2c836d;strokeWidth=1.5;fontColor=#7a6a55;fontSize=11;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="waits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#b5652a;strokeWidth=1.5;fontColor=#7a6a55;fontSize=11;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#7a6a55;strokeWidth=1.5;fontColor=#7a6a55;fontSize=11;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="Browse past a photo and it stops going first; a develop no longer wanted when its turn comes is dropped.&#10;So a RAW on screen never waits behind a background job." style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#514435;fontSize=12;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="1000" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="develop-gate-1" name="VI"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#efe5cc;strokeColor=#e2d4b3;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1040" height="380" as="geometry"/></mxCell><mxCell id="c3" value="Cổng xử lý RAW: ảnh trên màn hình luôn đi trước" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#2b2219;fontSize=16;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Ảnh trên màn hình&#10;xem trước · phóng to · cắt ảnh · tấm đang xem" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#2c836d;strokeColor=#2c836d;fontColor=#fffaee;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="380" height="80" as="geometry"/></mxCell><mxCell id="c5" value="Việc bạn không phải chờ&#10;bản xem trước chuẩn · tải trước · ước tính dung lượng&#10;xuất ảnh · phân tích ảnh đẹp nhất" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#fffaee;strokeColor=#e2d4b3;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="380" height="100" as="geometry"/></mxCell><mxCell id="c6" value="Cổng xử lý RAW&#10;mỗi lần một ảnh RAW&#10;theo mức ưu tiên" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="470" y="95" width="260" height="140" as="geometry"/></mxCell><mxCell id="c7" value="Xử lý RAW&#10;0,3–0,7 giây mỗi ảnh" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#fffaee;strokeColor=#e2d4b3;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="800" y="125" width="220" height="80" as="geometry"/></mxCell><mxCell id="c8" value="đi trước" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#2c836d;strokeWidth=1.5;fontColor=#7a6a55;fontSize=11;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="chờ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#b5652a;strokeWidth=1.5;fontColor=#7a6a55;fontSize=11;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#7a6a55;strokeWidth=1.5;fontColor=#7a6a55;fontSize=11;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="Lướt qua một ảnh thì ảnh đó thôi đi trước; việc xử lý không còn cần khi đến lượt sẽ được bỏ.&#10;Nhờ vậy ảnh RAW trên màn hình không bao giờ phải chờ sau một việc chạy nền." style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#514435;fontSize=12;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="1000" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>