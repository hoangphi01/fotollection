10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="240" height="80" as="geometry"/></mxCell><mxCell id="c7" value="A lemezen: normál előnézetek&#10;a háttérben, a bélyegképek után készülnek&#10;fotónként 0,66 MB" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#fffaee;strokeColor=#e2d4b3;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="290" y="170" width="470" height="80" as="geometry"/></mxCell><mxCell id="c8" value="27 ms" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#2c836d;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="170" width="240" height="80" as="geometry"/></mxCell><mxCell id="c9" value="Magából a fájlból&#10;a JPEG vagy RAW dekódolva, majd megtartva" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#fffaee;strokeColor=#b5652a;fontColor=#2b2219;fontSize=12;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="290" y="280" width="470" height="80" as="geometry"/></mxCell><mxCell id="c10" value="278 ms JPEG · 440 ms RAW" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#b5652a;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="280" width="240" height="80" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#7a6a55;strokeWidth=1.5;fontColor=#7a6a55;fontSize=11;fontFamily=system-ui,-apple-system,Segoe UI,sans-s