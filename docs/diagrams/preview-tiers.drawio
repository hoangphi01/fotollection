<mxfile host="Fotollection"><diagram id="preview-tiers-0" name="EN"><mxGraphModel dx="1000" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#efe5cc;strokeColor=#e2d4b3;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1040" height="400" as="geometry"/></mxCell><mxCell id="c3" value="Where a photo's preview comes from" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=none;strokeColor=none;fontColor=#2b2219;fontSize=16;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c4" value="You open a photo" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#2c836d;strokeColor=#2c836d;fontColor=#fffaee;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="220" height="70" as="geometry"/></mxCell><mxCell id="c5" value="In memory&#10;up to a quarter of the RAM (15, 25 or 40 %)&#10;the photo on screen and its neighbours" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fillColor=#dcebe3;strokeColor=#2c836d;fontColor=#2b2219;fontSize=13;fontFamily=system-ui,-apple-system,Segoe UI,sans-serif;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="290" y="60" width="470" height="80" as="geometry"/></mxCell><mxCell id="c6" value="at once" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;f